# Root .htaccess for RCMC Tender Portal
# Routes API requests to /api/ and frontend requests to /

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # API routes - handle through api/index.php
    RewriteRule ^api(/.*)?$ api/index.php [L]
    
    # Frontend routes - handle through index.html (React Router)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-l
    RewriteRule . index.html [L]
</IfModule>

# Set default character encoding
AddDefaultCharset UTF-8

# Disable directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "\.(env|log|md|git)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
